# terminu family template (tdp project/gitignore), copied to an app's
# .gitignore; replace ccdrawu. The app's own lines go below the last one.
/ccdrawu
/dist/
.local/
.idea/
.vscode/
.DS_Store
*.test
*.out
go.work
go.work.sum
# Claude Code: the maintainer's own instructions and settings stay out of git;
# harness's rules for the repo (.claude/rules/terminu.md) stay in.
CLAUDE.md
/.claude/*
!/.claude/rules/
/.claude/rules/*
!/.claude/rules/terminu.md

# Written by Claude Code each time it loads the plugin from this folder
.claude-plugin/types/
tsconfig.json
